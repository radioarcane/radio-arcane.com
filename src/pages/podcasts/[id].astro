---
import Layout from '@/layouts/Layout.astro';
import { Picture } from 'astro:assets';
import type { Props as SeoProps } from 'astro-seo';
import { getCollection } from 'astro:content';
import dayjs from 'dayjs';
import type { PodcastType } from '@/types';

import Breadcrumb from '@/components/Breadcrumb.astro';
import Container from '@/components/Container.astro';
import Heading from '@/components/Heading.astro';

import { getPlainText } from '@/js/util/markdown.ts';
import MixcloudPlayer from '@/components/MixcloudPlayer.astro';
import MixcloudSvg from '@/images/icons/mixcloud.svg';
import SoundcloudSvg from '@/images/icons/soundcloud.svg';
import SpotifySvg from '@/images/icons/spotify.svg';
import YoutubeSvg from '@/images/icons/youtube.svg';
import JsonLd from '@/components/JsonLd.astro';
import { eventPlaylist, radioEpisode, radioSeries } from '@/js/util/jsonLd';

export async function getStaticPaths() {
   const allPodcasts: PodcastType[] = await getCollection('podcast');
   return allPodcasts.map((podcast) => {
      return {
         params: { id: `${podcast.id}`.toLowerCase() },
         props: {
            podcast: podcast,
         },
      };
   });
}

const { siteName } = Astro.locals;

const { podcast } = Astro.props;

const description = getPlainText(podcast.body).split(/: Recorded|Recorded/);
const shortDescription = description[0].trim().slice(0, 154);

const seo: SeoProps = {
   title: `${podcast.data.title} | ${siteName}`,
   description: shortDescription.length ? `${shortDescription}…` : undefined,
};

// seo stuff

const jsonLd = [
   {
      ...radioSeries(Astro.locals),
      episode: await radioEpisode(podcast, Astro.locals),
   },
   await eventPlaylist(podcast.data.playlist, Astro.locals),
];
---

<Layout title={seo.title} seo={seo} includesBreadcrumb={true}>
   <Breadcrumb
      crumbs={[
         {
            href: '/',
            title: 'Home',
         },
         {
            href: '/podcasts/',
            title: 'Podcasts',
         },
         {
            href: `/podcasts/${podcast.id}/`,
            title: podcast.data.title,
         },
      ]}
   />

   <Container as="div">
      <article id={`podcast-${podcast.id}`}>
         <header>
            <Heading as="h1">
               {podcast.data.title}
            </Heading>
         </header>

         <div class="podcast-layout">
            {
               podcast.data?.image && (
                  <figure>
                     <a href={`/podcasts/${podcast.id}/`}>
                        <Picture
                           src={podcast.data.image}
                           alt={podcast.data.title}
                           formats={['webp']}
                           width={300}
                           height={300}
                           loading="lazy"
                        />
                     </a>
                  </figure>
               )
            }

            <section class="details">
               <time datetime={podcast.data.date}>
                  {dayjs(podcast.data.date).format('MMM. D, YYYY')}
               </time>

               <div class="description" set:html={podcast?.rendered?.html} />
            </section>

            <section class="listen">
               <div class="links">
                  <span>Listen on:</span>

                  {
                     podcast.data.youtubeLink && (
                        <a
                           href={podcast.data.youtubeLink}
                           target="_blank"
                           title={`Listen to ${podcast.data.title} on YouTube`}
                           class="youtube-link"
                        >
                           <YoutubeSvg aria-hidden="true" />
                        </a>
                     )
                  }

                  {
                     podcast.data.spotifyLink && (
                        <a
                           href={podcast.data.spotifyLink}
                           target="_blank"
                           title={`Listen to ${podcast.data.title} on Spotify`}
                           class="spotify-link"
                        >
                           <SpotifySvg aria-hidden="true" />
                        </a>
                     )
                  }

                  {
                     podcast.data.mixcloudLink && (
                        <a
                           href={podcast.data.mixcloudLink}
                           target="_blank"
                           title={`Listen to ${podcast.data.title} on Mixcloud`}
                           class="mixcloud-link"
                        >
                           <MixcloudSvg aria-hidden="true" />
                        </a>
                     )
                  }

                  {
                     podcast.data.soundcloudLink && (
                        <a
                           href={podcast.data.soundcloudLink}
                           target="_blank"
                           title={`Listen to ${podcast.data.title} on Soundcloud`}
                           class="soundcloud-link"
                        >
                           <SoundcloudSvg aria-hidden="true" />
                        </a>
                     )
                  }
               </div>
            </section>

            {
               podcast.data.mixcloudLink && (
                  <section class="player">
                     <MixcloudPlayer url={podcast.data.mixcloudLink} />
                  </section>
               )
            }
         </div>
      </article>
   </Container>

   <JsonLd slot="jsonLd" schema={jsonLd} />
</Layout>
<style>
   header {
   }

   figure {
      margin-bottom: var(--spacing-4x);
   }

   time {
      display: inline-block;
      opacity: 0.8;
      margin-bottom: var(--spacing-2x);
   }

   .description {
      max-inline-size: 70ch;
      text-wrap: balance;
   }

   .links {
      display: inline-flex;
      gap: var(--spacing-5x);
      align-items: center;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      margin-bottom: var(--spacing-4x);
   }

   .links a {
      color: var(--white-smoke);
      opacity: 1;
   }

   .links a:hover,
   .links a:focus,
   .links a:active {
      color: var(--white-smoke);
      opacity: 0.7;
   }

   .links svg {
      fill: currentColor;
      width: 45px;
   }

   .youtube-link svg {
      width: 32px;
   }

   .spotify-link svg {
      width: 32px;
   }

   @media (--lg-up) {
      .podcast-layout {
         display: grid;
         grid-template-columns: repeat(12, 1fr);
         grid-template-rows: repeat(auto, 1fr);
         grid-auto-rows: auto;
         gap: 0;
      }

      .details,
      .listen {
         padding-left: var(--spacing-8x);
      }

      .details {
         padding-bottom: 12px;
      }

      figure {
         grid-row-start: 1;
         grid-row-end: 4;
         grid-column-start: 1;
         grid-column-end: 4;
      }

      .details,
      .listen {
         grid-column-start: 4;
         grid-column-end: 13;
      }

      .player {
         grid-column-start: 1;
         grid-column-end: 13;
      }

      .player {
         padding-top: var(--spacing-4x);
      }
   }
</style>
