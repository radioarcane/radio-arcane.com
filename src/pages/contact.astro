---
import Layout from '@/layouts/Layout.astro';
import type { Props as SeoProps } from 'astro-seo';
import Button from '@/components/Button.astro';
import Container from '@/components/Container.astro';
import Heading from '@/components/Heading.astro';

const { siteName } = Astro.locals;

const seo: SeoProps = {
   title: `Contact | ${siteName}`,
   description: `Contact ${siteName}`,
};
---

<Layout title={seo.title} seo={seo}>
   <Container as="section">
      <header>
         <Heading as="h1"> Contact Radio Arcane </Heading>
      </header>

      <section>
         <form name="contact" method="POST" data-netlify="true">
            <div>
               <label for="name">Name<sup aria-label="required">*</sup></label>
               <input
                  type="text"
                  id="name"
                  name="name"
                  maxlength="150"
                  required
               />
            </div>

            <div>
               <label for="email">Email<sup aria-label="required">*</sup></label
               >
               <input
                  type="email"
                  id="email"
                  name="email"
                  maxlength="100"
                  required
               />
            </div>

            <div>
               <label for="message"
                  >Message<sup aria-label="required">*</sup></label
               >
               <textarea id="message" name="message" required></textarea>
            </div>

            <dv class="actions">
               <Button as="button" type="submit"> Submit </Button>
            </dv>
         </form>
      </section>
   </Container>
</Layout>

<style>
   form {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-6x);
      justify-content: flex-start;
      border: 1px solid var(--border-gray-2);
      padding: var(--spacing-6x) var(--gutter);
      max-width: 960px;
   }

   form sup {
      color: var(--warning-color);
      margin-top: -0.25em;
      margin-left: 0.25em;
   }

   .actions {
      display: flex;
      justify-content: center;
      align-items: center;
   }
</style>
