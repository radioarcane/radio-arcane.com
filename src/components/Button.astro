---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag = 'button'> = Polymorphic<{ as: Tag }> & {
   size?: 'sm';
   variant?: 'facebook';
   as?: 'button' | 'a';
};

const { as, size, variant, ...props } = Astro.props;

const Element = as || 'button';
---

<Element
   {...props}
   class:list={[
      'btn',
      size ? `btn--${size}` : null,
      variant ? `btn--${variant}` : null,
      props?.class,
   ]}
>
   <slot />
</Element>

<style>
   .btn {
      display: inline-flex;
      gap: var(--spacing-2x);
      text-align: center;
      font-weight: 400;
      white-space: nowrap;
      vertical-align: middle;
      letter-spacing: 0.02857em;
      border: 1px solid var(--white);
      color: var(--white);
      background: transparent;
      box-shadow:
         0px 1px 5px 0px rgba(0, 0, 0, 0.2),
         0px 2px 2px 0px rgba(0, 0, 0, 0.14),
         0px 3px 1px -2px rgba(0, 0, 0, 0.12);

      text-decoration: none;
      text-transform: uppercase;
      margin: 0;
      padding: var(--spacing-4x) var(--spacing-6x) var(--spacing-3x);
      opacity: 1;
      cursor: pointer;
      line-height: 1;
      cursor: pointer;
      vertical-align: middle;
      transition: all 0.15s ease-out;
      justify-content: center;
      align-items: center;
      align-content: center;
   }

   .btn:hover,
   .btn:focus,
   .btn:active {
      opacity: 0.8;
   }

   .btn--facebook {
      background: var(--facebook-blue);
      border-color: var(--facebook-blue);
   }

   .btn--sm {
      font-size: var(--text-xs);
      padding: var(--spacing-3x) var(--spacing-4x) var(--spacing-3x);
   }
</style>
